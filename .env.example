# ─── Application ──────────────────────────────────────────────────────────────
# Entorno de ejecución: development | test | production
NODE_ENV=development
# Puerto HTTP del servidor NestJS
PORT=3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
# 5433: si tu host ya tiene un PostgreSQL local en 5432, usa 5433 para el contenedor
DB_PORT=5433
DB_USER=identity
DB_PASSWORD=identity_dev_password
DB_NAME=identity_server
# SOLO para desarrollo local. En producción SIEMPRE false (se usan migraciones).
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Próximas fases (se añadirán aquí) ────────────────────────────────────────
# JWT_ISSUER=https://identity.local
# JWT_AUDIENCE=identity-server
# JWT_ACCESS_TTL=900
# JWT_REFRESH_TTL=1209600
# JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
# JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
